# monday.com personal API token (Apps > Developer > My Access Tokens)
MONDAY_API_TOKEN=

# Optional: add ?secret=<this value> to your webhook URL in monday
# Leave blank to skip the secret check entirely
WEBHOOK_SHARED_SECRET=

# Cursor Background Agents API key (cursor.com/settings → API Keys)
CURSOR_API_KEY=

# Cursor model ID for background agents. Defaults to gpt-5.5-medium.
# Examples: gpt-5.5-medium, gpt-5.5-high, claude-4.5-sonnet
CURSOR_MODEL=gpt-5.5-medium

# GitHub org used when the Repositories column contains a bare repo name
# (e.g. "ludeo-k8s-apps" → https://github.com/EdgeGamingGG/ludeo-k8s-apps)
DEFAULT_REPO_OWNER=EdgeGamingGG
