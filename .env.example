# ─── Agent provider ───────────────────────────────────────────────────────
# Default agent provider for new !set runs. Users can override per-command
# with `!set research --agent=anthropic`. One of: cursor, anthropic
AGENT_PROVIDER=cursor

# Optional: add ?secret=<this value> to your webhook URL
# Leave blank to skip the secret check entirely
WEBHOOK_SHARED_SECRET=

# ─── Cursor (agent provider) ──────────────────────────────────────────────
# Cursor Background Agents API key (cursor.com/settings → API Keys)
CURSOR_API_KEY=

# Cursor model ID for background agents. Defaults to composer-2.5-fast.
# Examples: composer-2.5-fast, claude-4.5-sonnet
CURSOR_MODEL=composer-2.5-fast

# ─── Anthropic (agent provider) ───────────────────────────────────────────
# Anthropic API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Anthropic model. Defaults to claude-opus-4-7.
ANTHROPIC_MODEL=claude-opus-4-7

# ─── monday.com (ticket provider) ─────────────────────────────────────────
# Personal API token (Apps > Developer > My Access Tokens)
MONDAY_API_TOKEN=

# ─── Jira (ticket provider) ───────────────────────────────────────────────
# Base URL of your Jira Cloud instance (no trailing slash)
JIRA_BASE_URL=

# Email + API token used for Basic auth
# Create the token at: id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional: id of the custom field that holds the repo URL on Jira issues
# (e.g. customfield_10042). If unset, the provider falls back to extracting
# the first GitHub URL from the issue description.
JIRA_REPO_FIELD=

# ─── Shared ───────────────────────────────────────────────────────────────
# GitHub org/user used when the repo column / field contains a bare repo name
# (e.g. "my-service" → https://github.com/<DEFAULT_REPO_OWNER>/my-service).
DEFAULT_REPO_OWNER=

# Slack bot token (xoxb-...) for DMing the user who triggered a !set command.
# Required scopes: users:read.email, chat:write
# Leave blank to disable Slack DMs.
SLACK_BOT_TOKEN=

# Comma-separated user IDs allowed to issue !set commands. Currently unused —
# commands are open to everyone on the board. Kept for future tightening.
AUTHORIZED_USER_IDS=
